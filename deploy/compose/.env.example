# compose 行为参数（非密钥）。复制为 .env 后按需修改：
#
#   cp .env.example .env
#
# .env 已被根 .gitignore 忽略；本文件只有变量名与占位符。
# shell 环境里同名变量优先级高于 .env（测试套件正是靠这一点并行运行）。

# 宿主机发布端口
HUB_PORT=9200
DASH_PORT=3200

# 数据目录（相对本文件所在目录；也可给绝对路径，如迁移到外置盘）
# COMPOSE_DATA_DIR=./data

# compose 项目名（决定容器/网络命名前缀；默认取本目录名）
# compose.yaml 里写了 `name: anet`，现网实测容器名就是 anet-hub-1 / anet-dashboard-1。
# 需要改项目名时设这一项（它会盖过文件里的 name:）。
# COMPOSE_PROJECT_NAME=anet

# 部署身份：hub 镜像 label 里记录的源码提交（pixb）。
# 构建时传进去：ANET_SOURCE_REV=$(git rev-parse HEAD) docker compose build
# ANET_SOURCE_REV=

# dashboard 镜像标签（镜像由 agent-network-dashboard 仓库构建，见 README）
# ANET_DASHBOARD_IMAGE_TAG=compose
