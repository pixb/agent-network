# compose 行为参数（非密钥）。复制为 .env 后按需修改：
#
#   cp .env.example .env
#
# .env 已被根 .gitignore 忽略；本文件只有变量名与占位符。
# shell 环境里同名变量优先级高于 .env（测试套件正是靠这一点并行运行）。

# 宿主机发布端口
HUB_PORT=9200
DASH_PORT=3000

# 数据目录（相对本文件所在目录；也可给绝对路径，如迁移到外置盘）
# COMPOSE_DATA_DIR=./data

# compose 项目名（决定容器/网络命名前缀；默认取本目录名）
# COMPOSE_PROJECT_NAME=anet

# hub 镜像的部署身份：构建时写进 label 的源码提交（pixb 生产分支，不发 npm）。
#   ANET_SOURCE_REV=$(git rev-parse HEAD) docker compose build hub
# 查：docker inspect anet-hub:compose --format '{{index .Config.Labels "org.opencontainers.image.revision"}}'
# ANET_SOURCE_REV=
