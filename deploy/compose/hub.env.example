# Hub 环境变量 —— 复制为 data/hub.env 后填真值，chmod 600。
#
#   cp hub.env.example data/hub.env && chmod 600 data/hub.env
#
# 🔴 data/ 整目录不进 git（见根 .gitignore）；本文件只有变量名与占位符。
# 🔴 密钥只能从加密备份恢复**原值** —— 重新生成的新值解不开既有密文。

# ===== 必填 =====
# 保险库主密钥：64 位十六进制。缺失时容器 fail-closed 拒启（entrypoint.sh）。
ANET_HUB_SECRET_VAULT_KEY=

# ===== 可选（不写 = 生产默认行为）=====
# COMMHUB_AUTH_TOKEN=        # 旧全局 Bearer（v0.8 起用 DB 内 token 体系，通常不设）
# COMMHUB_CORS_ORIGINS=      # 允许的 CORS 来源，逗号分隔
# COMMHUB_SESSION_IDLE_DAYS=
# COMMHUB_RETENTION_AUDIT_DAYS=
# COMMHUB_RETENTION_INBOX_ACKED_DAYS=
# COMMHUB_RETENTION_TASK_EVENTS_DAYS=
# COMMHUB_RETENTION_TELEMETRY_DAYS=
# COMMHUB_RETENTION_SWEEP_MINUTES=
# COMMHUB_DUE_REMINDERS=     # 到期提醒开关/网络/负责人等，见 server/src 源码
# COMMHUB_SCHEDULER_TICK_MS=
# COMMHUB_NODE_PERMISSIONS=
# COMMHUB_LOG_RING=
#
# SSE 推送调参（ANET_SSE_*，见 server/src/push.ts）：
# ANET_SSE_MAX_QUEUE_BYTES=
# ANET_SSE_STUCK_CLOSE_MS=
# ANET_SSE_KEEPALIVE_MS=
# ANET_SSE_LIVENESS_SWEEP_MS=
#
# ⚠️ 不要在这里设 COMMHUB_DB / COMMHUB_UPLOADS_DIR —— compose.yaml 已把它们
#    指到容器内 /data（=宿主机 data/ 目录）。在这里覆盖会把状态写到卷外。
